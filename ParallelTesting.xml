<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" thread-count="5" parallel="tests">
	<listeners>
		<listener class-name="utilities.ExtentReportManager" />
	</listeners>
	<!-- parallel runs the test parallel-->
	<!-- int test name give different names-->

	<test name="chromeTest">
		<parameter name="os" value="Windows" />
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="testCases.AccountRegistrationTest" />
			<class name="testCases.LoginTest" />
			<class name="testCases.SearchTest"></class>
		</classes>
	</test>

	<test name="edgeTest">
		<parameter name="os" value="Windows" /><!-- can chaneg the desired os by
		changig value-->
		<parameter name="browser" value="edge" /><!-- can chaneg the desired
		browser  by changig value-->
		<classes>
			<class name="testCases.AccountRegistrationTest" />
			<class name="testCases.LoginTest" />
			<class name="testCases.SearchTest"></class>
		</classes>
	</test>

	<test name="firefoxTest">
		<parameter name="os" value="Windows" />
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="testCases.AccountRegistrationTest" />
			<class name="testCases.LoginTest" />
			<class name="testCases.SearchTest"></class>
		</classes>
	</test>
</suite> 
